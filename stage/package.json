{
  "name": "livliv-stage",
  "productName": "LivLiv Stage",
  "version": "0.3.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/livliv-dev/stage",
  "repository": { "type": "git", "url": "git+https://github.com/livliv-dev/stage.git", "directory": "stage" },
  "bugs": "https://github.com/livliv-dev/stage/issues",
  "description": "Your AI-Native VTuber Studio: many 2D characters on one stage, each driven by your face, a script or AI, talking to each other and to your chat",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --import ./test/ts.mjs --test \"test/*.test.ts\"",
    "test:browser": "node test/browser.mjs",
    "test:profiles": "node test/profiles.mjs",
    "test:shots": "node test/shots.mjs",
    "test:projects": "node test/projects.mjs",
    "test:mixer": "node test/mixer.mjs",
    "test:audience": "node test/audience.mjs",
    "test:props": "node test/props.mjs",
    "test:gamepad": "node test/gamepad.mjs",
    "test:journey": "node test/journey.mjs",
    "test:live": "node test/live.mjs",
    "test:points": "node test/points.mjs",
    "test:app-livliv": "node test/app-livliv.mjs",
    "build:site": "node scripts/build-site.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@livliv-dev/player": "0.5.0",
    "@mediapipe/tasks-vision": "1.1.1",
    "@pixiv/three-vrm": "3.5.5",
    "fflate": "0.8.3",
    "lucide-react": "1.57.0",
    "mediabunny": "1.61.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "playwright-core": "1.64.1",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
